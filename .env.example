# setup.sh creates the real file at $NIMBUS_BOX_HOME/.env (chmod 600) and generates
# every secret below automatically. You normally only add your LLM key(s).
# NEVER commit the real .env.

# --- you provide ---
OPENROUTER_API_KEYS=
ANTHROPIC_API_KEYS=
OPENAI_API_KEYS=

# --- optional: public URLs when exposed behind a proxy / preview URL ---
# NIMBUS_PUBLIC_HOST=gateway.example.com      # allowed Host for the gateway MCP endpoint
# NIMBUS_DASHBOARD_URL=https://nimbus.example.com   # BETTER_AUTH_URL for dashboard sign-in (auto-derived on Upstash Boxes: https://<box-id>-3000.preview.box.upstash.com)
# PROXY_PORT=3000                              # https-aware proxy to expose (not 7000)
# PROXY_FORWARD_PROTO=https                    # set to http if you serve plain http

# --- generated by setup.sh ---
# POSTGRES_USER=nimbus
# POSTGRES_PASSWORD=...
# REDIS_PASSWORD=...
# QDRANT_API_KEY=...
# VNC_PASSWORD=...
# BETTER_AUTH_SECRET=...
